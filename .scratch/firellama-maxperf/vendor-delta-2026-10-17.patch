+    const short NG  = sgptg/16;
+    const short tid = tiisg%16;
+    const short ix  = tiisg/16;
+    const short ip  = tid/8;
+    const short il  = tid%8;
+    const short l0  = 4*il;
+    const short is  = 8*ip + l0/16;
