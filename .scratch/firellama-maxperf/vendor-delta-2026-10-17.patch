+        ushort tiisg[[thread_index_in_simdgroup]], \
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) { \
+    kernel_mul_mv_iq4_xs_f32_nc_impl<N_R0_IQ4_XS, NC>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); \
+}
