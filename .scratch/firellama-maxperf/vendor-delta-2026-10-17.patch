+[[host_name("kernel_mul_mv_iq4_xs_f32_c" #NC)]] \
+kernel void kernel_mul_mv_iq4_xs_f32_c##NC( \
+        constant ggml_metal_kargs_mul_mv & args, \
+        device const char * src0, \
+        device const char * src1, \
+        device       char * dst, \
