+            g_ct_ns_per_tick = 1.0;
+            MTLTimestamp c0 = 0, g0 = 0, c1 = 0, g1 = 0;
+            [dev sampleTimestamps:&c0 gpuTimestamp:&g0];
+            usleep(20000);
+            [dev sampleTimestamps:&c1 gpuTimestamp:&g1];
+            if (g1 > g0) { g_ct_ns_per_tick = (double) (c1 - c0)/(double) (g1 - g0); }
