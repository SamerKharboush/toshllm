+        case 4: ggml_vec_dot_iq2_xs_q8_K_x4(n, s, vx, vy); break;
+        default:
+            for (int c = 0; c < nc; ++c) ggml_vec_dot_iq2_xs_q8_K(n, s + c, 0, vx, 0, vy[c], 0, 1);
+    }
+}
