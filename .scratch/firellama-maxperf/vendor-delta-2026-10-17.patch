+static bool ggml_metal_gdn_state_fusion_on(ggml_metal_op_t ctx) {
+    static const bool disabled = TOSH_ENV("TOSH_GDN_STATE_FUSION_DISABLE") != nullptr;
+    return ctx->use_fusion() && !ctx->use_concurrency && !disabled;
+}
