diff --git a/ggml/src/ggml-metal/ggml-metal-device.cpp b/ggml/src/ggml-metal/ggml-metal-device.cpp
index 0dde5d443..e8fcd7b9e 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-device.cpp
@@ -1664,16 +1664,21 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv(ggml_meta
                 // cover the small-matrix case, which still wants one group with four rows.
                 // Sixteen lanes with four rows each: +5.8% over eight lanes. Sixteen lanes
                 // with the inherited rows loses, so the win lives in the crossing of the two.
                 if (simd_width == 64 && !q4k_small && TOSH_ENV("TOSH_MV_Q4K_W64_DISABLE") == nullptr) {
                     nsg    = 1;
                     nr0    = 4;
                     suffix = "_L16r4";
                     w64    = true;
+                    // eight rows share each x load; sixteen lanes win from 8192 rows up, plain below
+                    if (TOSH_ENV("TOSH_MV_ROWS8_DISABLE") == nullptr) {
+                        nr0    = 8;
+                        suffix = ne01 >= 8192 ? "_L16r8" : "_r8";
+                    }
                     break;
                 }
                 if (q4k_small) {
                     nsg = 1;
                     nr0 = 4;
                     suffix = "_r4";
                 } else {
                     nsg = N_SG_Q4_K;
@@ -1713,16 +1718,21 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv(ggml_meta
                     suffix = "_r4";
                 } else {
                     nsg = N_SG_Q6_K;
                     nr0 = N_R0_Q6_K;
                 }
                 // the 64-lane twin of this kernel lives in mul_mv_w64.metal
                 if (simd_width == 64 && TOSH_ENV("TOSH_MV_W64_DISABLE") == nullptr) {
                     w64 = true;
+                    // eight rows from 2048 rows up; fewer rows starve the grid and measured lower
+                    if (ne01 >= 2048 && TOSH_ENV("TOSH_MV_ROWS8_DISABLE") == nullptr) {
+                        nr0    = 8;
+                        suffix = "_r8";
+                    }
                 }
             } break;
         case GGML_TYPE_IQ2_XXS:
             {
                 nsg = N_SG_IQ2_XXS;
                 nr0 = N_R0_IQ2_XXS;
                 smem = 256*8+128;
                 // the 64-lane twin of this kernel lives in mul_mv_w64.metal
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 160db75a5..ba8dd9846 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10442,16 +10442,21 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
 
     // The SYCL backend picks between one and two output rows per subgroup by row count when there
     // are two destination columns (Q4_K_MMVQ_ROW_PAIR_MIN_NROWS in ggml-sycl/mmvq.cpp). Cover both
     // sides of that boundary, including an odd row count above it for the row-pair tail.
     for (int64_t m : {6271, 6272, 6273}) {
         test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F32, m, 2, 1024, { 1, 1 }, { 1, 1 }));
     }
 
+    // Metal on 64 lanes takes eight rows per group above a row count; odd counts cover the tail
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q6_K, GGML_TYPE_F32, 2051, 1, 2048, { 1, 1 }, { 1, 1 }));
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F32, 4099, 1, 4096, { 1, 1 }, { 1, 1 }));
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F32, 8197, 1, 4096, { 1, 1 }, { 1, 1 }));
+
     test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_0, GGML_TYPE_F32, 2880, 32, 2880, {1, 1}, {1, 1}));
     test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q8_0, GGML_TYPE_F32, 2880, 32, 2880, {1, 1}, {1, 1}));
     // q8_0 with three and four columns: few rows, a short row, and a large matrix
     for (int64_t n : {3, 4}) {
         for (auto mk : std::vector<std::array<int64_t, 2>>{{320, 2560}, {2560, 640}, {4096, 2560}, {8192, 512}}) {
             test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q8_0, GGML_TYPE_F32, mk[0], n, mk[1], {1, 1}, {1, 1}));
         }
     }
