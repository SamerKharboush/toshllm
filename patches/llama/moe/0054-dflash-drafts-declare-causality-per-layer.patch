diff --git a/src/models/dflash.cpp b/src/models/dflash.cpp
index 58e62f46d..b8be25bbc 100644
--- a/src/models/dflash.cpp
+++ b/src/models/dflash.cpp
@@ -97,16 +97,46 @@ void llama_model_dflash::load_arch_hparams(llama_model_loader & ml) {
     // DFlash has a single rope, so the SWA rope == main rope.
     if (ml.get_key(LLM_KV_ATTENTION_SLIDING_WINDOW, hparams.n_swa, false) && hparams.n_swa > 0) {
         hparams.swa_type = LLAMA_SWA_TYPE_STANDARD;
         ml.get_arr(LLM_KV_ATTENTION_SLIDING_WINDOW_PATTERN, hparams.is_swa_impl);
         hparams.rope_freq_base_train_swa  = hparams.rope_freq_base_train;
         hparams.rope_freq_scale_train_swa = hparams.rope_freq_scale_train;
     }
 
+    // attention.causal is one bool, or one bool per layer. A mixed pattern is only expressible
+    // through the two caches' masks, so it must coincide with the SWA pattern: SWA layers causal,
+    // dense layers non-causal (the draft context itself stays non-causal)
+    std::array<uint32_t, LLAMA_MAX_LAYERS> causal_layers{};
+    if (ml.get_arr(LLM_KV_ATTENTION_CAUSAL, causal_layers, false)) {
+        uint32_t n_causal = 0;
+        ml.get_arr_n(LLM_KV_ATTENTION_CAUSAL, n_causal);
+        if (n_causal != hparams.n_layer_all) {
+            throw std::runtime_error(format("DFlash attention.causal has %u entries for %u layers", n_causal, hparams.n_layer_all));
+        }
+        bool mixed = false;
+        for (uint32_t il = 1; il < hparams.n_layer_all; ++il) {
+            mixed |= causal_layers[il] != causal_layers[0];
+        }
+        std::string pattern;
+        for (uint32_t il = 0; il < hparams.n_layer_all; ++il) {
+            pattern += causal_layers[il] ? 'C' : 'N';
+            if (mixed && (causal_layers[il] != 0) != hparams.is_swa(il)) {
+                throw std::runtime_error("DFlash mixed attention.causal must match the sliding-window pattern (SWA layers causal, dense layers non-causal)");
+            }
+        }
+        hparams.causal_attn = !mixed && causal_layers[0];
+        if (mixed) {
+            hparams.non_causal_type = LLAMA_NON_CAUSAL_TYPE_DENSE_ONLY;
+        }
+        LLAMA_LOG_INFO("%s: DFlash per-layer causality = %s, non_causal_type = %d\n", __func__, pattern.c_str(), hparams.non_causal_type);
+    } else {
+        ml.get_key(LLM_KV_ATTENTION_CAUSAL, hparams.causal_attn, false);
+    }
+
     type = LLM_TYPE_UNKNOWN;
 }
 
