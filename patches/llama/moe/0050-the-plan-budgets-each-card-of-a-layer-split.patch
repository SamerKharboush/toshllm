+// Read VRAM for all GPU devices in enumeration order.
+// Returns vectors of free_mib and total_mib for each GPU device.
+void read_vram_per_device(std::vector<double> & free_mib, std::vector<double> & total_mib) {
+    free_mib.clear();
+    total_mib.clear();
+    const size_t nd = ggml_backend_dev_count();
+    int gpu_index = 0;
+    for (size_t i = 0; i < nd; ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        if (!dev) continue;
+        if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU &&
+            ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            continue;
+        }
+        size_t f = 0, t = 0;
+#ifdef TOSH_ENABLE_DYNAMIC_MOE
+        if (gpu_index == 0) {
+            // Device 0: use the existing read_vram logic (which uses tosh_vram_read internally)
+            double free_d = 0, total_d = 0;
+            if (!read_vram(free_d, total_d)) {
+                // fall back to backend query
+                ggml_backend_dev_memory(dev, &f, &t);
+            } else {
+                f = (size_t) (free_d * MiB);
+                t = (size_t) (total_d * MiB);
+            }
+        } else {
+            // Device >0: try tosh_dmoe_vram_dev first (set by Metal backend at init)
+            if (!tosh_dmoe_vram_dev(gpu_index, &f, &t)) {
+                // fall back to backend query
+                ggml_backend_dev_memory(dev, &f, &t);
+            }
+        }
+#else
+        ggml_backend_dev_memory(dev, &f, &t);
+#endif
+        if (t > 0) {
+            free_mib.push_back(f/MiB);
+            total_mib.push_back(t/MiB);
+        }
+        ++gpu_index;
+    }
+    // Apply simulation override if set (applies to all devices equally)
+    const double sim = env_mib("TOSH_AUTO_SIM_VRAM_MIB", 0);
+    if (sim > 0) {
+        for (size_t i = 0; i < free_mib.size(); ++i) {
+            free_mib[i] = std::max(0.0, sim - (total_mib[i] - free_mib[i]));
+            total_mib[i] = sim;
+        }
+    }
+}
