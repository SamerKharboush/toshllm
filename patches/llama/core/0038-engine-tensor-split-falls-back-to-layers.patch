 static struct ggml_backend_meta_split_state ggml_backend_meta_get_split_state(const struct ggml_tensor * tensor, bool assume_sync);
 
+// Every way a tensor split can fail to describe a tensor means the same thing to a caller: this
+// model cannot be split the way it was asked for. Aborting makes that read as a crash, after the
+// weights have usually already loaded. Report the reason and exit 86, which the app recognises and
+// retries once with --split-mode layer. TOSH_TENSOR_SPLIT_STRICT=1 keeps the abort for anyone
+// debugging the scheduler. This function does not return.
+GGML_NORETURN static void ggml_backend_meta_no_tensor_split(const char * fmt, ...);
+
+GGML_NORETURN static void ggml_backend_meta_no_tensor_split(const char * fmt, ...) {
+    char msg[512];
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(msg, sizeof(msg), fmt, args);
+    va_end(args);
+
+    const char * strict = getenv("TOSH_TENSOR_SPLIT_STRICT");
+    if (strict != NULL && atoi(strict) != 0) {
+        ggml_abort(__FILE__, __LINE__, "%s", msg);
+    }
+    fprintf(stderr, "ggml_backend_meta: %s\n", msg);
+    fprintf(stderr, "This model has no two-way tensor split. Restart with --split-mode layer.\n");
+    fflush(stderr);
+    exit(86);
+}
